global:
  resolve_timeout: 5m

route:
  receiver: slack-notifications
  group_by:
    - alertname
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 1h

receivers:
  - name: slack-notifications
    slack_configs:
      - api_url: "{{ slack_webhook_url | default('https://hooks.slack.com/services/REPLACE_ME') }}"
        channel: "#devops-alerts"
        send_resolved: true
        title: "{{ '{{' }} .CommonLabels.alertname {{ '}}' }}"
        text: "{{ '{{' }} .CommonAnnotations.description {{ '}}' }}"